# Runtime PostgreSQL connection. Keep the real value in local .env or an
# approved deployment secret store. DATABASE_URL is the canonical name.
DATABASE_URL=

# Temporary compatibility alias for the current local setup. Do not set both.
NEON_DATABASE_KEY=

# Optional Neon control-plane API credential. Not required for PostgreSQL queries.
NEON_API_KEY=

# Admin API is fail-closed until one mode is explicitly configured.
ARCHIVE_ADMIN_AUTH_MODE=disabled
ARCHIVE_RUNTIME=production

# Production Cloudflare Access JWT validation.
CF_ACCESS_TEAM_DOMAIN=
CF_ACCESS_AUD=
ARCHIVE_ADMIN_EMAILS=
ARCHIVE_QUARANTINE_EMAILS=

# Loopback-only development mode. Never deploy this token.
ARCHIVE_LOCAL_ADMIN_TOKEN=
ARCHIVE_LOCAL_ADMIN_SCOPES=archive:read,review:write
