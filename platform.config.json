    "full_cache_limit": null,
    "fetch_limit_per_run": 10,
    "fetch_limit_per_run_applies_to": "bounded_canary_only",
    "concurrency": 4,
    "max_concurrency": 8,
    "same_host_parallelism": 1,
    "per_host_min_interval_seconds": 1.0,
    "retryable_http_statuses": [
      429,
      500,
      502,
      503,
      504
    ],
    "retry_max_attempts": 5,
    "retry_backoff_cap_seconds": 60,
    "resume_strategy": "url_hash_receipts_plus_cache_index_skip_completed",
    "checkpoint_every_urls": 25,
    "max_bytes_per_asset": 15728640,
    "max_decoded_pixels_per_asset": 80000000,
    "minimum_free_disk_gib": 5,
    "disk_floor_behavior": "checkpoint_and_pause_then_resume_after_space_is_available",
    "authentication_or_paywall_bypass": false,
    "public_promotion": false,
    "r2_promotion": false,
    "item_rights_remain_separate": true
