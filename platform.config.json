  "duplicate_analysis": {
    "status": "internal_canary",
    "exact_prompt_scope": "all_canonical_records",
    "exact_media_scope": "all_local_canonical_assets",
    "perceptual_sample_limit": 128,
    "automatic_merge_or_delete": false,
    "remote_media_fetch": true,
    "remote_media_fetch_scope": "all_eligible_unique_direct_public_https_urls",
    "thumbnail_format": "webp",
    "thumbnail_max_dimension": 640,
    "private_index_excluded_from_dist": true
  },
  "analysis_routing": {
    "status": "active_policy",
    "goal": "deterministic_first_minimum_model_cost",
    "tiers": [
      {
        "tier": 0,
        "name": "deterministic_pre_filter",
        "uses_model": false,
        "responsibilities": [
          "prompt_sha256",
          "image_sha256",
          "url_normalization",
          "content_type_validation",
          "width_height_probe",
          "phash_dhash",
          "exact_duplicate_collapse"
        ]
      },
      {
        "tier": 1,
        "name": "heuristic_family_grouping",
        "uses_model": false,
        "responsibilities": [
          "token_normalization",
          "alias_detection",
          "same_prompt_different_subject_candidate",
          "same_image_different_prompt_candidate",
          "host_and_source_signals"
        ]
      },
      {
        "tier": 2,
        "name": "lightweight_semantic_judgement",
        "preferred_model": "gpt-5.6-luna",
        "use_only_for": [
          "ambiguous taxonomy tagging",
          "ordinary people and brand presence tagging",
          "family label suggestion",
          "search synonym expansion",
          "human readable duplicate notes"
        ]
      },
      {
        "tier": 3,
        "name": "high_confidence_review_assist",
        "preferred_model": "gpt-5.6-terra",
        "use_only_for": [
          "hard semantic conflicts",
          "merge recommendation drafts",
          "cross source canonical ranking with explanation",
          "people brand and rights risk triage before a release decision"
        ]
      },
      {
        "tier": 4,
        "name": "rare_escalation_only",
        "preferred_model": "gpt-5.6-sol",
        "use_only_for": [
          "final risk sensitive release adjudication after lower cost lanes",
          "exception policy edge cases explicitly escalated by a human"
        ],
        "batch_default": false
      }
    ],
    "cache_key": "content_sha256+analysis_schema_version+model_id+model_revision",
    "analyze_unique_hashes_only": true,
    "sol_batch_allowed": false
  },
  "media_delivery": {
    "status": "compressed_dist_webp_v1",
    "preferred_format": "webp",
    "preferred_format_for_future_public_bundle": "webp",
    "fallback_for_opaque": "jpeg",
    "fallback_for_alpha": "png",
    "dist_includes_original_source_media": false,
